<div class="row">
  <div class="medium-8 medium-centered columns">
    <div class="box">
      <div class="row">
        <div class="medium-5 columns text-center">
          <%= image_tag 'logo.png', width: '200px' %>
        </div>
        <div class="medium-7 columns">
          <div class="row text-right">
            <div class="small-12 columns">
              <label class="flat"><%= @scope == "admin" ? t("sessions.new.admin_title") : t("sessions.new.title") %></label>
            </div>
          </div>
          <%= form_with model: @account, scope: @scope, url: @form_url, builder: ApplicationFormBuilder do |f| %>
            <%= f.input :email, :autofocus => true, as: :email, placeholder: 'user@domain.com' %>
            <%= f.input :password %>
            <% if flash[:alert] %>
              <label class="error" style="padding-bottom: .5em;"><%= alert %></label>
            <% end %>
            <%= button_tag type: 'submit' do %>
              <%= t("sessions.new.submit") %> <i class='fa fa-sign-in'></i>
            <% end %>
          <% end %>
          <%= render "sessions/links" %>
        </div>
      </div>
    </div>
    <%= render 'sessions/poweredby' %>
  </div>
</div>
