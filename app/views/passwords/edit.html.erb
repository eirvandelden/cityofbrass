<div class="row">
  <div class="medium-8 medium-centered columns">
    <div class="box">
      <div class="row">
        <div class="medium-5 columns text-center">
          <%= image_tag 'logo.png', width: '200px' %>
        </div>
        <div class="medium-7 columns">
          <div class="row text-right">
            <div class="small-12 columns">
              <label class="flat"><%= t("passwords.edit.title") %></label>
            </div>
          </div>
          <%= form_with model: @account, scope: @scope, url: @form_url, method: :put, builder: ApplicationFormBuilder do |f| %>
            <%= f.input :password, label: t("passwords.edit.new_password") %>
            <%= f.input :password_confirmation %>
            <%= f.button :submit, t("passwords.edit.submit") %>
          <% end %>

        </div>
      </div>
    </div>
    <%= render 'sessions/poweredby' %>
  </div>
</div>
