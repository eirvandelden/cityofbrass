<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body style="background-color: #f6f6f5; font-size: 16px; color: #666; font-family: helvetica;">
    <div style="max-width: 600px; text-align: center; margin-left: auto; margin-right: auto;">
      <div style="background-color: #fff; border: 1px solid #c5c5c5; padding:20px; text-align: left;">
        <%= link_to image_tag("https://thecityofbrass.s3.amazonaws.com/assets/images/CityofBrass_200w.png", width: '100px'), "https://#{ENV['DEFAULT_BASE_URL']}" %>

        <p><%= t("passwords_mailer.reset.greeting", email: @account.email) %></p>

        <p><%= t("passwords_mailer.reset.instruction") %></p>

        <p><%= link_to t("passwords_mailer.reset.action"), @edit_url %></p>

        <p><%= t("passwords_mailer.reset.instruction_2") %></p>
        <p><%= t("passwords_mailer.reset.instruction_3") %></p>

        <p>
          <%= t("passwords_mailer.reset.regards") %><br>
          <%= t("passwords_mailer.reset.team") %>
        </p>

      </div>
    </div>
  </body>
</html>
