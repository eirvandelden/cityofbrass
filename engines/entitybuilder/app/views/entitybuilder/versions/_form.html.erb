<%= form_with model: @version, scope: :version, url: polymorphic_path([@parent_object, :versions]), builder: ApplicationFormBuilder do |f| %>
  <fieldset>
    <div class="row">
      <div class="medium-8 columns">
        <%= f.input :version_label, label: t("entitybuilder.versions.form.label"), required: true %>
      </div>
      <% if @parent_object.respond_to?(:monster_built?) && @parent_object.monster_built? %>
        <div class="medium-4 columns">
          <%= f.input :monster_level, label: t("entitybuilder.versions.form.monster_level"),
                input_html: { min: 1, max: 40 } %>
        </div>
      <% end %>
    </div>
  </fieldset>
  <div class="row">
    <div class="small-12 columns text-center">
      <%= f.submit t("entitybuilder.versions.form.submit"), class: "button" %>
    </div>
  </div>
<% end %>
