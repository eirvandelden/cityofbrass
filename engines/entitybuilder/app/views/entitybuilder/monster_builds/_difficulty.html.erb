<% difficulty = @parent_object.encounter_difficulty %>
<% if difficulty %>
  <fieldset id="encounter_difficulty">
    <legend><%= t("entitybuilder.monster_builds.difficulty.heading", campaign: @parent_object.encounter_campaign.name) %></legend>
    <% if difficulty.rating %>
      <p class="encounter-difficulty-rating" data-rating="<%= difficulty.rating %>">
        <%= t("entitybuilder.monster_builds.difficulty.ratings.#{difficulty.rating}") %>
      </p>
      <p class="encounter-difficulty-party">
        <%= t("entitybuilder.monster_builds.difficulty.party", count: difficulty.party_size, level: difficulty.party_level) %>
      </p>
    <% else %>
      <p class="encounter-difficulty-hint"><%= t("entitybuilder.monster_builds.difficulty.empty_party") %></p>
    <% end %>
  </fieldset>
<% end %>
